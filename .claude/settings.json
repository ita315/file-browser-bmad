{
  "extraKnownMarketplaces": {
    "ita-plugins": {
      "source": { "source": "github", "repo": "ita315/rules-review-kit" }
    }
  },
  "enabledPlugins": {
    "file-viewer@ita-plugins": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ]
  }
}